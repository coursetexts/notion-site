# ------------------------------------------------------------------------------
# This is an example .env file.
#
# All of these environment vars must be defined either in your environment or in
# a local .env file in order to run this app.
#
# @see https://github.com/rolodato/dotenv-safe for more details.
# ------------------------------------------------------------------------------

# Needs to be 'production' when deployed to prod
VERCEL_ENV=production

# Optional (for fathom analytics)
#NEXT_PUBLIC_FATHOM_ID=

# Optional (for PostHog analytics)
#NEXT_PUBLIC_POSTHOG_ID=

# Optional (for rendering tweets more efficiently)
#TWITTER_ACCESS_TOKEN=

# Optional (for persisting preview images to redis)
# NOTE: if you want to enable redis, only REDIS_HOST and REDIS_PASSWORD are required
# NOTE: don't forget to set isRedisEnabled to true in the site.config.ts file
#REDIS_HOST=
#REDIS_PASSWORD=
#REDIS_USER='default'
#REDIS_NAMESPACE='preview-images'
NEXT_PUBLIC_NOTION_PAGE_ID=

# Optional (for auto-filling a new learning path outline)
# Server-side only — never expose this key to the client.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Collective knowledge-graph daily job (pages/api/cron/rebuild-knowledge-graph.ts).
# Implemented but OFF: vercel.json has no cron, and the handler no-ops unless
# KNOWLEDGE_GRAPH_CRON_ENABLED=true. To turn it on later, set that flag, set
# CRON_SECRET, add GEMINI_API_KEY + SUPABASE_SERVICE_ROLE_KEY, and restore the
# Vercel cron in vercel.json. See docs/knowledge.md.
# KNOWLEDGE_GRAPH_CRON_ENABLED=true
# CRON_SECRET=

# Supabase (for Google auth + profiles; optional)
# Get these from your Supabase project: Settings → API
#NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
#NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Google OAuth: Authentication → URL configuration → Redirect URLs must include
# http://localhost:3000/auth/callback (keep Site URL as the live site). If that
# URL is missing, local Google sign-in redirects to production.

# Community seed script (scripts/seed-community.mjs) — server-side only.
# Never expose the service role key to the client. Refuse to run against prod.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# COMMUNITY_SEED_PROJECT_REF=your-disposable-project-ref
# E2E_MAYA_PASSWORD=
# E2E_DEVRAN_PASSWORD=
# E2E_LENA_PASSWORD=

