# ------------------------------------------------------------------------------
# Example environment for local development and Railway deploys.
# ------------------------------------------------------------------------------

# Needs to be 'production' when deployed to prod
VERCEL_ENV=production

# Required for local dev and production deploys
NEXT_PUBLIC_NOTION_PAGE_ID=
SESSION_SECRET=

# Optional production metadata / analytics
NEXT_PUBLIC_NOTION_PAGE_ID_PREVIEW=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FATHOM_ID=
NEXT_PUBLIC_POSTHOG_ID=

# Optional preview-site auth and config overrides
PASSWORD_PROTECT=false
PREVIEW_PASSWORD=
NEXT_PUBLIC_SITE_CONFIG=

# Optional (for rendering tweets more efficiently)
# TWITTER_ACCESS_TOKEN=

# Optional Google Sheets integrations used by the form endpoints
SPREADSHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional server-side key. Without it, /api/course-chat returns a graceful
# disabled response and the rest of the site continues to work.
OPENAI_API_KEY=

# Optional (for persisting preview images to redis)
# NOTE: if you want to enable redis, only REDIS_HOST and REDIS_PASSWORD are required
# NOTE: don't forget to set isRedisEnabled to true in the site.config.ts file
# REDIS_HOST=
# REDIS_PASSWORD=
# REDIS_USER=default
# REDIS_NAMESPACE=preview-images

# Supabase (required for Google auth and community persistence)
# Get both public values from your active project: Settings → API.
# Never commit a project-specific value here; configure it per environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — required for scripts/seed-community.mjs. NEVER expose
# to the client or commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# COMMUNITY_SEED_PROJECT_REF=your-disposable-project-ref
# E2E_MAYA_PASSWORD=
# E2E_DEVRAN_PASSWORD=
# E2E_LENA_PASSWORD=

# Mutating Playwright tests are opt-in and must name the disposable target.
# E2E_ALLOW_MUTATIONS=false
# E2E_PROJECT_REF=your-disposable-project-ref
# E2E_EMAIL=
# E2E_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://localhost:3000
